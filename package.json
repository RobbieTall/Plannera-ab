{
  "name": "plannera-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "migrate:deploy": "echo 'migrate disabled on vercel'",
    "db:push": "prisma db push",
    "build": "node ./scripts/prisma-generate.js && next build",
    "vercel-build": "npm run db:push && node ./scripts/prisma-generate.js && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx --test tests/*.test.ts",
    "test:site-resolver": "vitest run --config vitest.config.ts src/lib/site-resolver.test.ts",
    "test:site-resolver:google": "vitest run --config vitest.config.ts src/lib/site-resolver.google.test.ts src/app/api/site-context/site-context.test.ts",
    "test:byron-fixture": "tsx scripts/test-byron-landuse-fixture.ts",
    "fetch:nsw-xml": "tsx scripts/fetch-nsw-xml.ts",
    "ingest:legislation": "tsx scripts/legislation-ingest.ts",
    "ingest:all-nsw": "tsx scripts/ingest-all-nsw.ts",
    "ingest:sepps": "tsx scripts/ingest-sepps.ts",
    "refresh:legislation": "tsx scripts/refresh-legislation.ts",
    "refresh:sepps": "tsx scripts/refresh-sepps.ts",
    "sync:legislation": "tsx scripts/legislation-sync.ts",
    "legislation:coverage": "tsx scripts/legislation-coverage.ts",
    "sepp:smoke": "tsx scripts/sepp-smoke-test.ts",
    "test:sepp-ingestion": "tsx scripts/test-sepp-ingestion.ts",
    "nsw:data:test": "tsx scripts/nsw-data-check.ts",
    "nsw:lep:sources": "tsx scripts/list-nsw-lep-sources.ts",
    "journal:db:push": "drizzle-kit push --config=drizzle.config.ts",
    "journal:db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "journal:db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "journal:db:studio": "drizzle-kit studio --config=drizzle.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@auth/prisma-adapter": "^2.11.1",
    "@google/generative-ai": "^0.24.1",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/client": "^6.19.0",
    "@vercel/blob": "^2.0.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "firebase-admin": "^13.9.0",
    "lucide-react": "^0.553.0",
    "next": "14.2.33",
    "next-auth": "^4.24.13",
    "node-html-parser": "^7.0.1",
    "nodemailer": "^7.0.10",
    "openai": "^6.8.1",
    "pdf-parse": "^1.1.1",
    "prisma": "^6.19.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.3",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.33",
    "jsdom": "^27.2.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
