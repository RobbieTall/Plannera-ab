/// Prisma Client generator configuration.
generator client {
  provider = "prisma-client-js"
}

/// Primary datasource configuration. The DATABASE_URL is resolved from the
/// environment so Vercel/Prisma secrets never live in the repo.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Minimal identity model so Auth.js sessions can be persisted while we build
/// out planning-specific entities.
model User {
  id                  String               @id @default(uuid())
  name                String?
  email               String               @unique
  emailVerified       DateTime?
  image               String?
  plan                String               @default("free")
  createdAt           DateTime             @default(now())
  sessions            Session[]
  projects            Project[]            @relation("ProjectCreatedBy")
  projectMemberships  ProjectMember[]
  tasksCreated        Task[]               @relation("TaskCreatedBy")
  assignments         TaskAssignment[]
  artefacts           Artefact[]
  workspaceUploads    WorkspaceUpload[]
  ownedProjects       Project[]            @relation("ProjectOwner")
  purchases           Purchase[]
  entitlements        Entitlement[]
  consultantReferrals ConsultantReferral[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Physical or virtual location we are planning improvements for.
model Property {
  id        String    @id @default(cuid())
  name      String
  address   String?
  city      String?
  state     String?
  country   String?
  notes     String?
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Project groups tasks under a property and tracks its lifecycle.
model Project {
  id                     String                  @id @default(cuid())
  publicId               String                  @unique @default(dbgenerated("concat('proj-', substr(replace(gen_random_uuid()::text, '-', ''), 1, 18))"))
  name                   String
  title                  String                  @default("Untitled project")
  description            String?
  status                 ProjectStatus           @default(PLANNING)
  isDemo                 Boolean                 @default(false)
  lepData                Json?                   @db.JsonB
  dcpData                Json?                   @db.JsonB
  zoningCode             String?
  zoningName             String?
  zoningSource           String?
  zoning                 String?
  address                String?
  sessionId              String?
  userId                 String?
  propertyId             String
  property               Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdById            String?
  createdBy              User?                   @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  owner                  User?                   @relation("ProjectOwner", fields: [userId], references: [id])
  startDate              DateTime?
  dueDate                DateTime?
  tasks                  Task[]
  collaborators          ProjectMember[]
  artefacts              Artefact[]
  workspaceUploads       WorkspaceUpload[]
  workspaceSourceChunks  WorkspaceSourceChunk[]
  projectNotifications   ProjectNotification[]
  chatMessages           ChatMessage[]
  commercialFunnelEvents CommercialFunnelEvent[]
  purchases              Purchase[]
  entitlements           Entitlement[]
  consultantReferrals    ConsultantReferral[]
  siteContext            SiteContext?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([sessionId])
  @@index([userId])
}

/// Join table between users and projects, allowing role-specific access.
model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(VIEWER)
  invitedBy String?
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedAt DateTime    @default(now())

  @@unique([projectId, userId])
}

/// Fine-grained pieces of work required to complete a project.
model Task {
  id           String           @id @default(cuid())
  title        String
  description  String?
  status       TaskStatus       @default(TODO)
  priority     TaskPriority     @default(MEDIUM)
  projectId    String
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById  String?
  createdBy    User?            @relation("TaskCreatedBy", fields: [createdById], references: [id])
  dueDate      DateTime?
  costEstimate Decimal?         @db.Decimal(10, 2)
  assignments  TaskAssignment[]
  tags         TaskTag[]
  dependencies TaskDependency[] @relation("TaskDependencies")
  dependents   TaskDependency[] @relation("TaskDependents")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

/// Many-to-many relation that tracks which users own or contribute to tasks.
model TaskAssignment {
  id         String   @id @default(cuid())
  taskId     String
  userId     String
  role       TaskRole @default(CONTRIBUTOR)
  assignedAt DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

/// Association table between tasks and tags for quick filtering.
model TaskTag {
  taskId String
  tagId  String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model Tag {
  id        String    @id @default(cuid())
  name      String
  color     String?
  tasks     TaskTag[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([name])
}

/// Directed acyclic dependency between tasks.
model TaskDependency {
  id          String @id @default(cuid())
  taskId      String
  dependsOnId String
  task        Task   @relation("TaskDependents", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn   Task   @relation("TaskDependencies", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETE
  ARCHIVED
}

enum ProjectRole {
  OWNER
  COLLABORATOR
  VIEWER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskRole {
  OWNER
  CONTRIBUTOR
  REVIEWER
}

model Artefact {
  id                     String                  @id @default(cuid())
  projectId              String
  project                Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById            String?
  createdBy              User?                   @relation(fields: [createdById], references: [id])
  type                   ArtefactType
  title                  String
  source                 String?
  sourceUrl              String?
  overlays               String[]                @default([])
  notes                  String?
  imageUrl               String?
  payload                Json?
  capturedAt             DateTime?               @default(now())
  staleAt                DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  commercialFunnelEvents CommercialFunnelEvent[]
  purchases              Purchase[]              @relation("PurchaseQuickSiteCheckArtefact")
  entitlements           Entitlement[]           @relation("EntitlementQuickSiteCheckArtefact")
  consultantReferrals    ConsultantReferral[]

  @@index([projectId])
}

model Purchase {
  id                       String         @id @default(cuid())
  userId                   String
  user                     User           @relation(fields: [userId], references: [id])
  projectId                String
  project                  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quickSiteCheckArtefactId String
  quickSiteCheckArtefact   Artefact       @relation("PurchaseQuickSiteCheckArtefact", fields: [quickSiteCheckArtefactId], references: [id])
  proposalFingerprint      String
  productCode              String
  productVersion           String
  amountMinor              Int
  currency                 String
  status                   PurchaseStatus @default(PENDING)
  providerName             String?
  providerReference        String?
  providerIntentReference  String?
  idempotencyKey           String         @unique
  scopeKey                 String
  entitlement              Entitlement?
  submissionSeeCredit      SubmissionSeeCredit? @relation("SubmissionSeeCreditTarget")
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  paidAt                   DateTime?
  failedAt                 DateTime?
  cancelledAt              DateTime?
  refundedAt               DateTime?

  @@index([scopeKey, status])
  @@index([userId, projectId])
  @@index([providerName, providerReference])
}

model Entitlement {
  id                       String            @id @default(cuid())
  userId                   String
  user                     User              @relation(fields: [userId], references: [id])
  projectId                String
  project                  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quickSiteCheckArtefactId String
  quickSiteCheckArtefact   Artefact          @relation("EntitlementQuickSiteCheckArtefact", fields: [quickSiteCheckArtefactId], references: [id])
  proposalFingerprint      String
  productCode              String
  productVersion           String
  purchaseId               String            @unique
  purchase                 Purchase          @relation(fields: [purchaseId], references: [id])
  submissionSeeCredits     SubmissionSeeCredit[] @relation("SubmissionSeeCreditSource")
  status                   EntitlementStatus @default(ACTIVE)
  activeScopeKey           String?           @unique
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  activatedAt              DateTime          @default(now())
  refundedAt               DateTime?
  revokedAt                DateTime?

  @@index([projectId, quickSiteCheckArtefactId, proposalFingerprint, productCode, productVersion, status])
  @@index([userId, projectId])
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum EntitlementStatus {
  ACTIVE
  REFUNDED
  REVOKED
}

model ConsultantReferral {
  id                      String                    @id @default(cuid())
  projectId               String
  project                 Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewRequestArtefactId String                    @unique
  reviewRequestArtefact   Artefact                  @relation(fields: [reviewRequestArtefactId], references: [id], onDelete: Cascade)
  submittedByUserId       String?
  submittedByUser         User?                     @relation(fields: [submittedByUserId], references: [id], onDelete: SetNull)
  contactName             String
  contactEmail            String
  contactFingerprint      String
  consentVersion          String
  consentedAt             DateTime
  packageSnapshot         Json                      @db.JsonB
  packageDigest           String
  queueTarget             String                    @default("plannera_human_queue")
  scopeKey                String                    @unique
  idempotencyKey          String                    @unique
  status                  ConsultantReferralStatus  @default(SUBMITTED)
  submittedAt             DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  closedAt                DateTime?
  deleteAfter             DateTime?
  events                  ConsultantReferralEvent[]

  @@index([projectId, submittedAt])
  @@index([status, submittedAt])
  @@index([deleteAfter])
}

model ConsultantReferralEvent {
  id         String                      @id @default(cuid())
  referralId String
  referral   ConsultantReferral          @relation(fields: [referralId], references: [id], onDelete: Cascade)
  fromStatus ConsultantReferralStatus?
  toStatus   ConsultantReferralStatus
  actorType  ConsultantReferralActorType
  reasonCode String?
  occurredAt DateTime                    @default(now())

  @@index([referralId, occurredAt])
}

enum ConsultantReferralStatus {
  SUBMITTED
  ACKNOWLEDGED
  ASSIGNED
  CONSULTANT_ACKNOWLEDGED
  NEEDS_INFORMATION
  DECLINED
  CLOSED
}

enum ConsultantReferralActorType {
  USER
  OPERATOR
  SYSTEM
}

model CommercialFunnelEvent {
  id                   String                           @id @default(cuid())
  projectId            String
  project              Project                          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  artefactId           String?
  artefact             Artefact?                        @relation(fields: [artefactId], references: [id], onDelete: Cascade)
  eventName            CommercialFunnelEventName
  source               CommercialFunnelEventSource
  funnelVersion        String
  schemaVersion        Int
  idempotencyKey       String                           @unique
  includedInConversion Boolean
  exclusionReason      CommercialFunnelExclusionReason?
  occurredAt           DateTime                         @default(now())
  expiresAt            DateTime

  @@index([eventName, occurredAt])
  @@index([includedInConversion, occurredAt])
  @@index([expiresAt])
  @@index([projectId, eventName])
}

enum CommercialFunnelEventName {
  CHECK_STARTED
  SITE_RESOLVED
  QUICK_SITE_CHECK_SAVED
  PROJECT_PROMOTED
  DETAILED_PLANNING_PACK_GENERATED
  DETAILED_PLANNING_PACK_READY
  DETAILED_PLANNING_PACK_UNRESOLVED
  PLANNING_FEASIBILITY_SUMMARY_GENERATED
  SEE_GENERATED
  EXPERT_REVIEW_PACKAGE_GENERATED
  HANDOFF_COPIED
  HANDOFF_DOWNLOADED
  CONSULTANT_REFERRAL_SUBMITTED
}

enum CommercialFunnelEventSource {
  SERVER_CONFIRMED
  VERIFIED_INTERACTION
}

enum CommercialFunnelExclusionReason {
  NON_PRODUCTION
  DEMO_PROJECT
  INTERNAL_PROJECT
  DEV_BYPASS
}

model ChatMessage {
  id                  String   @id @default(cuid())
  projectId           String
  role                String // "user" | "assistant" | "system"
  content             String
  confidenceScore     Float?
  confidenceBreakdown Json?
  lepSourceRefs       String[] @default([])
  reactions           Json?
  createdAt           DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model ProjectNotification {
  id        String                  @id @default(cuid())
  projectId String
  project   Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      ProjectNotificationType
  title     String
  message   String
  lgaCode   String?
  readAt    DateTime?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@unique([projectId, type, lgaCode])
  @@index([projectId, readAt])
}

enum ProjectNotificationType {
  LGA_SEARCHABLE_READY
}

model LgaCoverageState {
  id                  String              @id @default(cuid())
  lgaCode             String              @unique
  state               LgaCoverageMaturity @default(NOT_STARTED)
  activePreparationId String?
  lastPreparedAt      DateTime?
  errorMessage        String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  preparations        LgaPreparationJob[]

  @@index([state])
}

model LgaPreparationJob {
  id                   String               @id @default(cuid())
  lgaCode              String
  status               LgaPreparationStatus @default(QUEUED)
  requestedByProjectId String?
  dedupeKey            String               @unique
  startedAt            DateTime?
  finishedAt           DateTime?
  errorMessage         String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  coverage             LgaCoverageState     @relation(fields: [lgaCode], references: [lgaCode], onDelete: Cascade)

  @@index([lgaCode, status])
}

enum LgaCoverageMaturity {
  NOT_STARTED
  QUEUED
  PROCESSING
  SEARCHABLE_READY
  STRUCTURED_PARTIAL
  VERIFIED
  FAILED_REVIEW_NEEDED
}

enum LgaPreparationStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum ArtefactType {
  map_snapshot
  quick_site_check
  pre_see_planning_memo
  detailed_planning_pack
  feasibility
  review_request
}

model Instrument {
  id                String             @id @default(cuid())
  slug              String             @unique
  name              String
  shortName         String
  jurisdiction      String             @default("NSW")
  instrumentType    InstrumentType
  sourceUrl         String
  lastSyncedAt      DateTime?
  clauses           Clause[]
  lepZoneObjectives LepZoneObjective[]
  lepZoneLandUses   LepZoneLandUse[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([instrumentType])
}

model Clause {
  id            String             @id @default(cuid())
  instrumentId  String
  instrument    Instrument         @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  clauseKey     String
  title         String?
  bodyHtml      String
  bodyText      String
  hierarchyPath String[]
  version       Int                @default(1)
  isCurrent     Boolean            @default(true)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  retrievedAt   DateTime?
  contentHash   String
  searchIndex   ClauseSearchIndex?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([instrumentId, clauseKey, version])
  @@index([instrumentId, clauseKey])
  @@index([isCurrent])
}

model ClauseSearchIndex {
  clauseId  String   @id
  clause    Clause   @relation(fields: [clauseId], references: [id], onDelete: Cascade)
  bodyText  String
  embedding Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LepZoneObjective {
  id           String     @id @default(cuid())
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  zoneCode     String
  objective    String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([instrumentId, zoneCode, objective])
  @@index([instrumentId])
  @@index([zoneCode])
}

model LepZoneLandUse {
  id           String            @id @default(cuid())
  instrumentId String
  instrument   Instrument        @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  zoneCode     String
  permission   LepZonePermission
  description  String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([instrumentId, zoneCode, permission, description])
  @@index([instrumentId])
  @@index([zoneCode])
}

enum InstrumentType {
  SEPP
  LEP
  DCP
  ACT
  REGULATION
  OTHER
}

enum LepZonePermission {
  WITHOUT_CONSENT
  WITH_CONSENT
  PROHIBITED
}

model WorkspaceUpload {
  id                 String                     @id @default(cuid())
  projectId          String
  project            Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  fileName           String
  fileExtension      String?
  mimeType           String?
  fileSize           Int
  storagePath        String
  publicUrl          String
  contentHash        String?
  extractedText      String?
  extractionMethod   String?
  extractionMetadata Json?
  extractedAt        DateTime?
  pageCount           Int?
  evidenceStatus     EvidenceReadabilityStatus  @default(NEEDS_REVIEW)
  reviewReason       String?
  indexingStatus     EvidenceIndexingStatus     @default(NOT_APPLICABLE)
  indexedAt          DateTime?
  indexingError      String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  sourceChunks WorkspaceSourceChunk[]

  @@index([projectId])
  @@index([userId])
}

enum EvidenceReadabilityStatus {
  READY
  PARTIALLY_READABLE
  IMAGE_ONLY
  NEEDS_REVIEW
}

enum EvidenceIndexingStatus {
  READY
  PENDING
  FAILED
  NOT_APPLICABLE
}

enum WorkspaceSourceType {
  upload
  council_dcp
  dcp // legacy value retained for compatibility
}

model WorkspaceSourceChunk {
  id                String              @id @default(cuid())
  projectId         String?
  uploadId          String?
  councilDocumentId String?
  lgaCode           String?
  heading           String?
  content           String
  embedding         Json?
  sourceType        WorkspaceSourceType @default(upload)
  metadata          Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  project         Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  upload          WorkspaceUpload? @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  councilDocument CouncilDocument? @relation(fields: [councilDocumentId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([lgaCode])
}

model CouncilDocument {
  id            String                 @id @default(cuid())
  lgaCode       String
  title         String
  sourceUrl     String
  fileName      String
  fileExtension String?
  mimeType      String?
  fileSize      Int?
  storagePath   String
  publicUrl     String
  extractedText String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  chunks        WorkspaceSourceChunk[]

  @@unique([lgaCode])
  @@index([lgaCode])
}

model DCPClause {
  id             String   @id @default(cuid())
  lgaCode        String
  instrumentSlug String?
  ref            String?
  title          String?
  headingPath    String[]
  parentRef      String?
  depth          Int?
  bodyHtml       String
  bodyText       String
  topicTags      String[] @default([])
  numericMeta    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([lgaCode])
  @@index([instrumentSlug])
  @@index([ref])
}

model DevelopmentControlPlanLink {
  id        String   @id @default(cuid())
  lgaCode   String   @unique
  name      String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteContext {
  id               String   @id @default(cuid())
  projectId        String   @unique
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  addressInput     String
  formattedAddress String
  lgaName          String?
  lgaCode          String?
  parcelId         String?
  lot              String?
  planNumber       String?
  latitude         Float?
  longitude        Float?
  zone             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum SubmissionSeeCreditStatus {
  RESERVED
  CONSUMED
  RELEASED
}

model SubmissionSeeCredit {
  id                  String                    @id @default(cuid())
  sourceEntitlementId String
  sourceEntitlement   Entitlement               @relation("SubmissionSeeCreditSource", fields: [sourceEntitlementId], references: [id])
  targetPurchaseId    String                    @unique
  targetPurchase      Purchase                  @relation("SubmissionSeeCreditTarget", fields: [targetPurchaseId], references: [id])
  scopeKey            String
  idempotencyKey      String                    @unique
  listAmountMinor     Int
  creditAmountMinor   Int
  payableAmountMinor  Int
  currency            String
  status              SubmissionSeeCreditStatus @default(RESERVED)
  reservedAt          DateTime                  @default(now())
  consumedAt          DateTime?
  releasedAt          DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([sourceEntitlementId, status])
  @@index([scopeKey, status])
}
