/// Prisma Client generator configuration.
generator client {
  provider = "prisma-client-js"
}

/// Primary datasource configuration. The DATABASE_URL is resolved from the
/// environment so Vercel/Prisma secrets never live in the repo.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Minimal identity model so Auth.js sessions can be persisted while we build
/// out planning-specific entities.
model User {
  id                 String            @id @default(cuid())
  name               String?
  email              String?           @unique
  emailVerified      DateTime?
  image              String?
  plan               String            @default("free")
  sessions           Session[]
  projects           Project[]         @relation("ProjectCreatedBy")
  projectMemberships ProjectMember[]
  tasksCreated       Task[]            @relation("TaskCreatedBy")
  assignments        TaskAssignment[]
  artefacts          Artefact[]
  workspaceUploads   WorkspaceUpload[]
  commercialFunnelEvents CommercialFunnelEvent[]
  purchases              Purchase[]
  entitlements            Entitlement[]
  spatialEvidenceReviews SpatialEvidenceReviewEvent[] @relation("SpatialEvidenceReviewActor")
  spatialEvidenceLatestReviews SpatialEvidence[] @relation("SpatialEvidenceReviewedBy")
  evidenceApplicabilityReviews EvidenceApplicabilityReviewEvent[] @relation("EvidenceApplicabilityReviewActor")
  evidenceApplicabilityLatestReviews WorkspaceUpload[] @relation("EvidenceApplicabilityReviewedBy")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Physical or virtual location we are planning improvements for.
model Property {
  id        String    @id @default(cuid())
  name      String
  address   String?
  city      String?
  state     String?
  country   String?
  notes     String?
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Project groups tasks under a property and tracks its lifecycle.
model Project {
  id               String            @id @default(cuid())
  publicId         String            @unique @default(cuid())
  name             String
  description      String?
  status           ProjectStatus     @default(PLANNING)
  isDemo           Boolean           @default(false)
  lepData          Json?
  propertyId       String
  property         Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdById      String?
  createdBy        User?             @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  startDate        DateTime?
  dueDate          DateTime?
  tasks            Task[]
  collaborators    ProjectMember[]
  artefacts        Artefact[]
  workspaceUploads WorkspaceUpload[]
  spatialEvidence  SpatialEvidence[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

/// Join table between users and projects, allowing role-specific access.
model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(VIEWER)
  invitedBy String?
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedAt DateTime    @default(now())

  @@unique([projectId, userId])
}

/// Fine-grained pieces of work required to complete a project.
model Task {
  id           String           @id @default(cuid())
  title        String
  description  String?
  status       TaskStatus       @default(TODO)
  priority     TaskPriority     @default(MEDIUM)
  projectId    String
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById  String?
  createdBy    User?            @relation("TaskCreatedBy", fields: [createdById], references: [id])
  dueDate      DateTime?
  costEstimate Float?
  assignments  TaskAssignment[]
  tags         TaskTag[]
  dependencies TaskDependency[] @relation("TaskDependencies")
  dependents   TaskDependency[] @relation("TaskDependents")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

/// Many-to-many relation that tracks which users own or contribute to tasks.
model TaskAssignment {
  id         String   @id @default(cuid())
  taskId     String
  userId     String
  role       TaskRole @default(CONTRIBUTOR)
  assignedAt DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

/// Association table between tasks and tags for quick filtering.
model TaskTag {
  taskId String
  tagId  String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model Tag {
  id        String    @id @default(cuid())
  name      String
  color     String?
  tasks     TaskTag[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([name])
}

/// Directed acyclic dependency between tasks.
model TaskDependency {
  id          String @id @default(cuid())
  taskId      String
  dependsOnId String
  task        Task   @relation("TaskDependents", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn   Task   @relation("TaskDependencies", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETE
  ARCHIVED
}

enum ProjectRole {
  OWNER
  COLLABORATOR
  VIEWER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskRole {
  OWNER
  CONTRIBUTOR
  REVIEWER
}

model Artefact {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?        @relation(fields: [createdById], references: [id])
  type        ArtefactType
  title       String
  source      String
  sourceUrl   String?
  overlays    Json?
  notes       String?
  imageUrl    String
  capturedAt  DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  commercialFunnelEvents CommercialFunnelEvent[]
  purchases              Purchase[]    @relation("PurchaseQuickSiteCheckArtefact")
  entitlements           Entitlement[] @relation("EntitlementQuickSiteCheckArtefact")
  spatialEvidence        SpatialEvidence?
  applicableUploads      WorkspaceUpload[] @relation("WorkspaceUploadApplicabilityDpp")

  @@index([projectId])
}

model SpatialEvidence {
  id                     String                       @id @default(cuid())
  artefactId             String                       @unique
  artefact               Artefact                     @relation(fields: [artefactId], references: [id], onDelete: Cascade)
  projectId              String
  project                Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceAuthority        SpatialSourceAuthority
  contentHash            String
  siteFingerprint        String
  siteAddress            String
  parcelId               String?
  lot                    String?
  planNumber             String?
  latitude               Float?
  longitude              Float?
  layers                 Json
  legendStatus           SpatialLegendStatus
  legendNotes            String?
  observation            String
  limitation             String
  observationConfirmedAt DateTime
  sourceEffectiveAt      DateTime?
  sourceCheckedAt        DateTime
  expiresAt              DateTime
  status                 SpatialEvidenceStatus        @default(PENDING_REVIEW)
  reviewedAt             DateTime?
  reviewedById           String?
  reviewedBy             User?                        @relation("SpatialEvidenceReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote             String?
  applicabilityTopics    Json?
  version                Int                          @default(1)
  reviewEvents           SpatialEvidenceReviewEvent[]
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt

  @@index([projectId])
  @@index([siteFingerprint])
  @@index([status])
  @@index([expiresAt])
  @@unique([id, version])
}

model SpatialEvidenceReviewEvent {
  id                String                        @id @default(cuid())
  spatialEvidenceId String
  spatialEvidence   SpatialEvidence               @relation(fields: [spatialEvidenceId], references: [id], onDelete: Cascade)
  actorUserId       String?
  actor             User?                         @relation("SpatialEvidenceReviewActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  decision          SpatialEvidenceReviewDecision
  previousStatus    SpatialEvidenceStatus
  resultingStatus   SpatialEvidenceStatus
  topics            Json
  note              String?
  createdAt         DateTime                      @default(now())

  @@index([spatialEvidenceId])
  @@index([actorUserId])
}

enum SpatialSourceAuthority {
  NSW_GOVERNMENT
  COUNCIL
  CONSULTANT
  SURVEYOR
  USER_PROVIDED
  OTHER
}

enum SpatialLegendStatus {
  CAPTURED
  SOURCE_LINKED
  NOT_AVAILABLE
  NOT_APPLICABLE
}

enum SpatialEvidenceStatus {
  PENDING_REVIEW
  ACCEPTED
  REJECTED
  CONFLICT
  SUPERSEDED
}

enum SpatialEvidenceReviewDecision {
  ACCEPT
  REJECT
  MARK_CONFLICT
  SUPERSEDE
}

model Purchase {
  id                         String         @id @default(cuid())
  userId                     String
  user                       User           @relation(fields: [userId], references: [id])
  projectId                  String
  project                    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quickSiteCheckArtefactId   String
  quickSiteCheckArtefact     Artefact       @relation("PurchaseQuickSiteCheckArtefact", fields: [quickSiteCheckArtefactId], references: [id])
  proposalFingerprint        String
  productCode                String
  productVersion             String
  amountMinor                Int
  currency                   String
  status                     PurchaseStatus @default(PENDING)
  providerName               String?
  providerReference          String?
  providerIntentReference    String?
  idempotencyKey             String         @unique
  scopeKey                   String
  entitlement                Entitlement?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  paidAt                     DateTime?
  failedAt                   DateTime?
  cancelledAt                DateTime?
  refundedAt                 DateTime?

  @@index([scopeKey, status])
  @@index([userId, projectId])
  @@index([providerName, providerReference])
}

model Entitlement {
  id                         String            @id @default(cuid())
  userId                     String
  user                       User              @relation(fields: [userId], references: [id])
  projectId                  String
  project                    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quickSiteCheckArtefactId   String
  quickSiteCheckArtefact     Artefact          @relation("EntitlementQuickSiteCheckArtefact", fields: [quickSiteCheckArtefactId], references: [id])
  proposalFingerprint        String
  productCode                String
  productVersion             String
  purchaseId                 String            @unique
  purchase                   Purchase          @relation(fields: [purchaseId], references: [id])
  status                     EntitlementStatus @default(ACTIVE)
  activeScopeKey             String?           @unique
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  activatedAt                DateTime          @default(now())
  refundedAt                 DateTime?
  revokedAt                  DateTime?

  @@index([projectId, quickSiteCheckArtefactId, proposalFingerprint, productCode, productVersion, status])
  @@index([userId, projectId])
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum EntitlementStatus {
  ACTIVE
  REFUNDED
  REVOKED
}

model CommercialFunnelEvent {
  id                  String                           @id @default(cuid())
  projectId           String
  project             Project                          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  artefactId           String?
  artefact             Artefact?                        @relation(fields: [artefactId], references: [id], onDelete: Cascade)
  eventName            CommercialFunnelEventName
  source               CommercialFunnelEventSource
  funnelVersion        String
  schemaVersion        Int
  idempotencyKey       String                           @unique
  includedInConversion Boolean
  exclusionReason      CommercialFunnelExclusionReason?
  occurredAt           DateTime                         @default(now())
  expiresAt            DateTime

  @@index([eventName, occurredAt])
  @@index([includedInConversion, occurredAt])
  @@index([expiresAt])
  @@index([projectId, eventName])
}

enum CommercialFunnelEventName {
  CHECK_STARTED
  SITE_RESOLVED
  QUICK_SITE_CHECK_SAVED
  PROJECT_PROMOTED
  DETAILED_PLANNING_PACK_GENERATED
  DETAILED_PLANNING_PACK_READY
  DETAILED_PLANNING_PACK_UNRESOLVED
  PLANNING_FEASIBILITY_SUMMARY_GENERATED
  SEE_GENERATED
  EXPERT_REVIEW_PACKAGE_GENERATED
  HANDOFF_COPIED
  HANDOFF_DOWNLOADED
  CONSULTANT_REFERRAL_SUBMITTED
}

enum CommercialFunnelEventSource {
  SERVER_CONFIRMED
  VERIFIED_INTERACTION
}

enum CommercialFunnelExclusionReason {
  NON_PRODUCTION
  DEMO_PROJECT
  INTERNAL_PROJECT
  DEV_BYPASS
}

enum ArtefactType {
  map_snapshot
  quick_site_check
  pre_see_planning_memo
  detailed_planning_pack
  feasibility
  review_request
}

model Instrument {
  id             String         @id @default(cuid())
  slug           String         @unique
  name           String
  shortName      String
  jurisdiction   String         @default("NSW")
  instrumentType InstrumentType
  sourceUrl      String
  lastSyncedAt   DateTime?
  clauses        Clause[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([instrumentType])
}

model Clause {
  id            String             @id @default(cuid())
  instrumentId  String
  instrument    Instrument         @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  clauseKey     String
  title         String?
  bodyHtml      String
  bodyText      String
  hierarchyPath Json
  version       Int                @default(1)
  isCurrent     Boolean            @default(true)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  retrievedAt   DateTime?
  contentHash   String
  searchIndex   ClauseSearchIndex?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([instrumentId, clauseKey, version])
  @@index([instrumentId, clauseKey])
  @@index([isCurrent])
}

model ClauseSearchIndex {
  clauseId  String   @id
  clause    Clause   @relation(fields: [clauseId], references: [id], onDelete: Cascade)
  bodyText  String
  embedding Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum InstrumentType {
  SEPP
  LEP
  DCP
  ACT
  REGULATION
  OTHER
}

model WorkspaceUpload {
  id                 String                     @id @default(cuid())
  projectId          String
  project            Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  fileName           String
  fileExtension      String?
  mimeType           String?
  fileSize           Int
  storagePath        String
  publicUrl          String
  contentHash        String?
  extractedText      String?
  extractionMethod   String?
  extractionMetadata Json?
  extractedAt        DateTime?
  pageCount           Int?
  evidenceStatus     EvidenceReadabilityStatus  @default(NEEDS_REVIEW)
  reviewReason       String?
  indexingStatus     EvidenceIndexingStatus     @default(NOT_APPLICABLE)
  indexedAt          DateTime?
  indexingError      String?
  applicabilityStatus EvidenceApplicabilityStatus @default(PENDING_REVIEW)
  applicabilityArtefactId String?
  applicabilityArtefact Artefact? @relation("WorkspaceUploadApplicabilityDpp", fields: [applicabilityArtefactId], references: [id], onDelete: SetNull)
  acceptedSiteFingerprint String?
  acceptedProposalFingerprint String?
  applicabilityTopics Json?
  sourceDocumentDate DateTime?
  validUntil DateTime?
  applicabilityReviewedAt DateTime?
  applicabilityReviewedById String?
  applicabilityReviewedBy User? @relation("EvidenceApplicabilityReviewedBy", fields: [applicabilityReviewedById], references: [id], onDelete: SetNull)
  applicabilityReviewNote String?
  applicabilityVersion Int @default(1)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  applicabilityReviewEvents EvidenceApplicabilityReviewEvent[]

  @@index([projectId])
  @@index([userId])
  @@index([applicabilityStatus])
  @@index([applicabilityArtefactId])
  @@unique([id, applicabilityVersion])
}

model EvidenceApplicabilityReviewEvent {
  id                          String                      @id @default(cuid())
  uploadId                    String
  upload                      WorkspaceUpload             @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  actorUserId                 String?
  actor                       User?                       @relation("EvidenceApplicabilityReviewActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  decision                    EvidenceApplicabilityDecision
  previousStatus              EvidenceApplicabilityStatus
  resultingStatus             EvidenceApplicabilityStatus
  detailedPlanningPackId      String?
  siteFingerprint             String?
  proposalFingerprint         String?
  topics                      Json
  sourceDocumentDate          DateTime?
  validUntil                  DateTime?
  note                        String?
  createdAt                   DateTime                    @default(now())

  @@index([uploadId])
  @@index([actorUserId])
}

enum EvidenceApplicabilityStatus {
  PENDING_REVIEW
  ACCEPTED
  REJECTED
  CONFLICT
  SUPERSEDED
}

enum EvidenceApplicabilityDecision {
  ACCEPT
  REJECT
  MARK_CONFLICT
  SUPERSEDE
}

enum EvidenceReadabilityStatus {
  READY
  PARTIALLY_READABLE
  IMAGE_ONLY
  NEEDS_REVIEW
}

enum EvidenceIndexingStatus {
  READY
  PENDING
  FAILED
  NOT_APPLICABLE
}

model DCPClause {
  id             String   @id @default(cuid())
  lgaCode        String
  instrumentSlug String?
  ref            String?
  title          String?
  headingPath    String[]
  parentRef      String?
  depth          Int?
  bodyHtml       String
  bodyText       String
  topicTags      String[] @default([])
  numericMeta    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([lgaCode])
  @@index([instrumentSlug])
  @@index([ref])
}
